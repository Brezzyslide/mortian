{
  "name": "project-name",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "synth": "pnpm --filter @project/infra synth",
    "local:setup": "node scripts/local.mjs setup",
    "local": "node scripts/local.mjs start",
    "local:daily": "node scripts/local.mjs daily",
    "local:reset": "node scripts/local.mjs reset"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~5.8.3"
  }
}
