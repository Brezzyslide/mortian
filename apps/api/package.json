{
  "name": "@project/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@project/adapters": "workspace:*",
    "@project/db": "workspace:*",
    "@project/domain": "workspace:*",
    "@project/identity": "workspace:*",
    "@project/ledger": "workspace:*",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "~5.8.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.0"
  }
}
