# Copy to .env for local development. Never commit .env.
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/project_dev
MIGRATE_ON_BOOT=true

# Generate each with: openssl rand -base64 32
AUTH_JWT_SECRET=
AUTH_OTP_PEPPER=
AUTH_FIELD_KEY=

# Only "sandbox" exists until an SMS provider is chosen. Refused when APP_ENV=production.
MESSAGING_PROVIDER=sandbox

# Only "sandbox" exists until a collections provider is chosen. Refused when APP_ENV=production.
COLLECTIONS_PROVIDER=sandbox
# Generate with: openssl rand -hex 32
COLLECTIONS_WEBHOOK_SECRET=
